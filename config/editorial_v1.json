{
  "version": "1.0.0",
  "mission": "Construir una fábrica autónoma de historias, audiencias y oportunidades comerciales para la cultura digital latinoamericana.",
  "safe_mode": {
    "dry_run": true,
    "publishing_enabled": false,
    "social_tokens_allowed": false,
    "runway_enabled": false,
    "max_candidates_per_run": 3,
    "max_packages_per_run": 1
  },
  "territories": {
    "gaming_esports": 50,
    "sport_technology_entertainment": 20,
    "ai_innovation_future": 15,
    "brands_activations": 15
  },
  "formats": [
    "radar_estratosferico",
    "esto_cambia_el_juego",
    "brand_play"
  ],
  "audience_intelligence": {
    "enabled": true,
    "mode": "analysis_only",
    "publishing_enabled": false,
    "automatic_strategy_changes_enabled": false,
    "comparison_window_hours": 48,
    "minimum_sample_warning": 30,
    "format_mix": {
      "short_video": 35,
      "carousel": 25,
      "image_or_photo": 20,
      "conversation_or_poll": 15,
      "long_analysis": 5
    }
  },
  "content_punch_gate": {
    "enabled": true,
    "publishing_enabled": false,
    "requires_human_review": true,
    "required_fields": [
      "hook",
      "concrete_value",
      "tension_question",
      "expected_action"
    ],
    "high_impact_requires": {
      "conversation_potential": 0.8,
      "angle_originality": 0.75
    }
  },
  "editorial_citation_policy": {
    "enabled": true,
    "publishing_enabled": false,
    "human_review_required": true,
    "internal_max_excerpt_seconds": 3,
    "allowed_purposes": [
      "analysis",
      "criticism",
      "news_reporting"
    ],
    "required_controls": [
      "minimum_necessary",
      "transformative_commentary",
      "source_attribution",
      "source_link_preserved",
      "original_music_removed",
      "uploader_identity_verified"
    ],
    "notice": "El límite interno reduce riesgo, pero no constituye una regla legal ni garantiza ausencia de reclamaciones."
  },
  "platform_order": [
    "instagram",
    "facebook",
    "youtube",
    "threads",
    "tiktok"
  ],
  "editorial_score": {
    "minimum": 65,
    "weights": {
      "latam_relevance": 25,
      "explanatory_value": 20,
      "angle_originality": 20,
      "verifiability": 15,
      "conversation_potential": 10,
      "commercial_potential": 10
    }
  },
  "opportunity_selector": {
    "version": "1.0.0",
    "mode": "deterministic_zero_cost",
    "minimum_score": 65,
    "max_selected_per_run": 1,
    "weights": {
      "editorial_quality": 25,
      "conversation_potential": 25,
      "explanatory_value": 15,
      "commercial_potential": 15,
      "latam_relevance": 10,
      "angle_originality": 10
    },
    "views_only_success_allowed": false,
    "publishing_enabled": false,
    "external_actions_enabled": false,
    "human_approval_required": true
  },
  "hard_reject": [
    "missing_source",
    "duplicate_story",
    "unverified_rumor",
    "unlicensed_media_dependency",
    "unsupported_claim",
    "outside_editorial_territory",
    "missing_substantive_summary",
    "summary_equivalent_to_title",
    "summary_placeholder",
    "summary_truncated",
    "summary_does_not_fulfill_title_promise",
    "summary_visual_metadata_only",
    "summary_lacks_distinct_informative_proposition"
  ],
  "allowed_output_states": [
    "draft",
    "needs_review"
  ]
}

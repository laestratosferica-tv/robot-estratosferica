{
  "version": "1.0.0",
  "mode": "production_safety_baseline",
  "coordinator_workflow": "factory-v1-dry-run.yml",
  "defaults": {
    "scheduled_runs_enabled": false,
    "external_writes_enabled": false,
    "publishing_enabled": false,
    "paid_generation_enabled": false,
    "dry_run": true
  },
  "phase1_acceptance": {
    "required_consecutive_runs": 5,
    "require_source_registry": true,
    "require_stable_queue": true,
    "max_billable_operations_per_run": 0,
    "max_cost_usd_per_run": 0.0
  },
  "canonical_paths": {
    "ugc_inbox": "ugc/inbox",
    "ugc_metadata": "ugc/meta",
    "ugc_review_queue": "ugc/review",
    "state": "ugc/state"
  },
  "workflow_inventory": {
    "community-radar-readonly.yml": "controlled_readonly",
    "drive-sync.yml": "legacy_quarantine",
    "editorial.yml": "legacy_quarantine",
    "editorial-radar-dry-run.yml": "controlled_readonly",
    "factory-v1-ci.yml": "ci",
    "factory-v1-dry-run.yml": "coordinator",
    "epic-play-radar-readonly.yml": "controlled_readonly",
    "live-source-radar.yml": "controlled_readonly",
    "hype-packer.yml": "legacy_quarantine",
    "media_engine.yml": "legacy_quarantine",
    "platform-credential-diagnostic.yml": "controlled_diagnostic",
    "publisher.yml": "legacy_quarantine",
    "reddit-gamer-radar.yml": "legacy_quarantine",
    "threads-auth-check.yml": "controlled_diagnostic",
    "twitch-harvester.yml": "legacy_quarantine",
    "ugc-mode-c.yml": "legacy_quarantine",
    "ugc.yml": "legacy_quarantine",
    "ugc_feedback.yml": "legacy_quarantine",
    "viral-brain.yml": "legacy_quarantine",
    "youtube-harvester.yml": "legacy_quarantine"
  },
  "legacy_publishers": [
    "editorial.yml",
    "media_engine.yml",
    "publisher.yml",
    "ugc.yml"
  ],
  "activation_rules": {
    "legacy_gate": "vars.LEGACY_WORKFLOWS_ARMED == 'true'",
    "production_gate": "vars.PRODUCTION_ARMED == 'true'",
    "readonly_gate": "vars.READONLY_SCANS_ARMED == 'true'",
    "merge_requires_owner_approval": true,
    "credentials_must_not_change": true
  },
  "platform_readiness": {
    "threads": [
      "THREADS_USER_ACCESS_TOKEN_CONFIGURED",
      "THREADS_USER_ID_CONFIGURED"
    ],
    "instagram": [
      "IG_ACCESS_TOKEN_CONFIGURED",
      "IG_USER_ID_CONFIGURED"
    ],
    "facebook": [
      "FB_PAGE_ACCESS_TOKEN_CONFIGURED",
      "FB_PAGE_ID_CONFIGURED"
    ],
    "youtube": [
      "YOUTUBE_CLIENT_ID_CONFIGURED",
      "YOUTUBE_CLIENT_SECRET_CONFIGURED",
      "YOUTUBE_REFRESH_TOKEN_CONFIGURED"
    ],
    "r2": [
      "R2_ENDPOINT_URL_CONFIGURED",
      "AWS_ACCESS_KEY_ID_CONFIGURED",
      "AWS_SECRET_ACCESS_KEY_CONFIGURED",
      "BUCKET_NAME_CONFIGURED"
    ],
    "drive": [
      "GDRIVE_SERVICE_ACCOUNT_JSON_CONFIGURED",
      "GDRIVE_FOLDER_ID_CONFIGURED"
    ],
    "openai": [
      "OPENAI_API_KEY_CONFIGURED"
    ]
  }
}
